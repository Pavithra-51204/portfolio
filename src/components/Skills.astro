---
import { getCollection } from 'astro:content';

const groups = (await getCollection('skillGroups')).sort((a, b) => a.data.order - b.data.order);
---

<section id="skills" class="border-t border-ink/10">
  <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
    <h2 class="mb-8 text-2xl font-semibold tracking-tight md:text-3xl">Skills</h2>

    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {groups.map((group) => (
        <div>
          <h3 class="mb-3 font-mono text-xs text-ink/65">{group.data.label}</h3>
          <div class="flex flex-wrap gap-1.5">
            {group.data.items.map((item) => (
              <span class="border border-ink/15 px-2 py-1 font-mono text-xs text-ink/75">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
