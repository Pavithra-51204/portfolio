---
import { getCollection } from 'astro:content';

const groups = (await getCollection('skillGroups')).sort((a, b) => a.data.order - b.data.order);
---

<section id="skills" style="
  padding: 7rem 0;
  border-top: 1px solid var(--border);
">
  <div class="section-container">
    <div class="reveal" style="margin-bottom: 4rem;">
      <span class="eyebrow">05 — Skills</span>
      <h2 style="
        font-family: var(--font-serif);
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-top: 0.75rem;
      ">
        Tools & technologies.
      </h2>
    </div>

    <div
      class="reveal stagger-children"
      style="
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2.5rem;
      "
    >
      {groups.map((group) => (
        <div>
          <h3 style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-tertiary);
            margin-bottom: 0.875rem;
          ">{group.data.label}</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.4375rem;">
            {group.data.items.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
