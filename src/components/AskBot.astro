---
const qas = [
  {
    q: "What is she working on?",
    a: "Currently working as an SAP Analyst Intern at Kaar Technologies evaluating AI adoption and business ROI, while actively building agentic AI architectures such as AgentForge (LangGraph + MCP) and VelocityLB (Go L7 load balancer)."
  },
  {
    q: "What has she published?",
    a: "Two peer-reviewed IEEE Xplore papers: one on hybrid TCNs for smart-meter electricity theft detection, and one on multi-agent dynamic data fusion for flood forecasting (93.5% accuracy, 0.96 AUC-ROC). She has also filed and published two Indian patent applications in cloud security compliance (CloudSecAgent) and AI student guidance."
  },
  {
    q: "What are her strongest skills?",
    a: "Agentic AI orchestration (LangGraph, MCP, RAG), systems programming (Python, Go, Java), cloud & DevOps (AWS, Azure, Docker, Kubernetes, Terraform), and enterprise SAP ABAP/OData integrations."
  },
  {
    q: "Why a Master's?",
    a: "Seeking Fall 2027 graduate admissions (MS in AI / ML / Data Science) to deepen research and engineering expertise in scalable agentic systems, model evaluation, and efficient machine learning architectures."
  },
  {
    q: "How can I reach her?",
    a: "The fastest way to reach her is via email at pavithra.manogaran2004@gmail.com. She is also reachable on LinkedIn and GitHub."
  }
];
---

<section id="bot" class="site-section">
  <div class="section-container">
    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 2.5rem;">
      <span class="eyebrow">07 — Interactive Summary</span>
      <h2 class="section-heading">Ask My Bot</h2>
      <p style="font-size: 1rem; color: var(--text-secondary); max-width: 54ch;">
        Quick answers about research publications, engineering focus, and graduate study goals.
      </p>
    </div>

    <!-- Chat Card matching reference design -->
    <div
      class="app-card"
      style="
        padding: 2rem;
        background: radial-gradient(circle at 90% 20%, color-mix(in srgb, var(--accent) 10%, transparent) 0%, var(--card-bg) 60%);
      "
    >
      <div
        style="
          display: grid;
          grid-template-columns: 1fr;
          gap: 2rem;
          align-items: start;
        "
        class="bot-grid"
      >
        <!-- Left: Bot Avatar & Interactive Chat Stream -->
        <div>
          <!-- Header with Avatar & Hello bubble -->
          <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
            <!-- Cute Bot SVG Avatar matching reference -->
            <div
              style="
                width: 52px;
                height: 52px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--grad-start), var(--grad-end));
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 30%, transparent);
                flex-shrink: 0;
              "
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="10" rx="2"/>
                <circle cx="12" cy="5" r="2"/>
                <path d="M12 7v4"/>
                <line x1="8" y1="16" x2="8" y2="16"/>
                <line x1="16" y1="16" x2="16" y2="16"/>
              </svg>
            </div>

            <!-- Speech bubble -->
            <div
              style="
                background: var(--bg-surface);
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 0.5rem 1rem;
                font-family: var(--font-mono);
                font-size: 0.8125rem;
                color: var(--accent);
                font-weight: 600;
                box-shadow: var(--shadow-sm);
              "
            >
              Hello! 👋 Click any question below to ask.
            </div>
          </div>

          <!-- Chat Conversation View Area -->
          <div
            id="bot-chat-window"
            style="
              min-height: 180px;
              background: color-mix(in srgb, var(--accent) 3%, var(--bg-surface));
              border: 1px solid var(--border-subtle);
              border-radius: 12px;
              padding: 1.25rem;
              display: flex;
              flex-direction: column;
              gap: 1rem;
            "
          >
            <!-- Default bot greeting -->
            <div class="chat-message bot" style="display: flex; flex-direction: column; gap: 0.35rem;">
              <span style="font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; color: var(--accent); font-weight: 600;">
                Assistant
              </span>
              <div
                id="bot-response-text"
                style="
                  font-size: 0.9375rem;
                  line-height: 1.6;
                  color: var(--text-primary);
                "
              >
                {qas[0].a}
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Clickable Question Chips -->
        <div>
          <span style="font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-tertiary); display: block; margin-bottom: 0.85rem;">
            Suggested Questions
          </span>

          <div style="display: flex; flex-direction: column; gap: 0.6rem;">
            {qas.map((item, index) => (
              <button
                type="button"
                class={`bot-q-btn ${index === 0 ? 'active' : ''}`}
                data-question={item.q}
                data-answer={item.a}
                style="
                  display: flex;
                  align-items: center;
                  justify-content: space-between;
                  gap: 0.5rem;
                  text-align: left;
                  padding: 0.8rem 1.1rem;
                  background: var(--bg-surface);
                  border: 1px solid var(--border);
                  border-radius: 10px;
                  font-family: var(--font-mono);
                  font-size: 0.8125rem;
                  color: var(--text-primary);
                  cursor: pointer;
                  transition: all 0.2s ease;
                "
              >
                <span>{item.q}</span>
                <span style="color: var(--accent); font-weight: 700;">&rarr;</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Pure Static Fallback for No-JS: Accessible Plain List -->
    <noscript>
      <div style="margin-top: 2rem;">
        <h4 style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--accent); margin-bottom: 1rem;">
          Frequently Asked Questions
        </h4>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {qas.map((item) => (
            <div class="app-card" style="padding: 1.25rem;">
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.4rem;">{item.q}</strong>
              <p style="margin: 0; color: var(--text-secondary); font-size: 0.875rem;">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </noscript>
  </div>
</section>

<style>
  @media (min-width: 900px) {
    .bot-grid {
      grid-template-columns: 1.2fr 0.8fr !important;
    }
  }

  .bot-q-btn:hover {
    border-color: var(--accent) !important;
    background: color-mix(in srgb, var(--accent) 8%, transparent) !important;
    transform: translateX(3px);
  }
  .bot-q-btn.active {
    border-color: var(--accent) !important;
    background: color-mix(in srgb, var(--accent) 12%, transparent) !important;
  }
</style>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('.bot-q-btn');
    var responseEl = document.getElementById('bot-response-text');

    if (!buttons.length || !responseEl) return;

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');

        var answer = btn.getAttribute('data-answer') || '';
        responseEl.textContent = answer;
      });
    });
  })();
</script>

