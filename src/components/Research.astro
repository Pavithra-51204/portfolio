---
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const patents = (await getCollection('patents')).sort((a, b) => a.data.order - b.data.order);
---

<section id="research" style="
  padding: 7rem 0;
  border-top: 1px solid var(--border);
  background: color-mix(in srgb, var(--accent) 2%, var(--bg));
">
  <div class="section-container">
    <div class="reveal" style="margin-bottom: 4rem;">
      <span class="eyebrow">04 — Research</span>
      <h2 style="
        font-family: var(--font-serif);
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-top: 0.75rem;
      ">
        Published. Filed.<br/>
        <span class="text-gradient" style="font-style:italic;">Peer-reviewed.</span>
      </h2>
      <!-- Research interests line -->
      <p style="
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--text-secondary);
        margin-top: 1rem;
        max-width: 60ch;
        line-height: 1.6;
      ">
        Research interests: agentic AI, multi-agent systems, retrieval-augmented generation, model evaluation, and efficient / green ML.
      </p>
    </div>

    <!-- Publications -->
    <div class="reveal" style="margin-bottom: 5rem;">
      <span class="eyebrow" style="display:block; margin-bottom: 2rem;">Publications</span>
      <div style="display: flex; flex-direction: column; gap: 2.5rem;">
        {publications.map((pub) => (
          <article style="
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2rem;
            align-items: start;
            padding: 2rem;
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: var(--shadow-sm);
          " class="pub-card">
            <div>
              <div style="margin-bottom: 0.75rem;">
                <span class="ieee-badge">IEEE Xplore</span>
              </div>
              <h3 style="
                font-family: var(--font-serif);
                font-size: 1.3125rem;
                line-height: 1.3;
                color: var(--text-primary);
                margin-bottom: 0.75rem;
              ">
                {pub.data.url ? (
                  <a
                    href={pub.data.url}
                    target="_blank"
                    rel="noopener"
                    style="
                      color: inherit;
                      text-decoration: underline;
                      text-decoration-color: color-mix(in srgb, var(--accent) 30%, transparent);
                      text-underline-offset: 4px;
                      transition: text-decoration-color 0.2s;
                    "
                    onmouseover="this.style.textDecorationColor='var(--accent)'"
                    onmouseout="this.style.textDecorationColor='color-mix(in srgb, var(--accent) 30%, transparent)'"
                  >
                    {pub.data.title}
                  </a>
                ) : pub.data.title}
              </h3>
              <p style="
                font-size: 0.9rem;
                color: var(--text-secondary);
                line-height: 1.65;
              ">{pub.data.summary}</p>

              <!-- Metrics callout for flood forecasting paper -->
              {pub.data.id === 'flood-forecasting-fusion' && (
                <div style="
                  display: flex;
                  gap: 2rem;
                  margin-top: 1.25rem;
                  padding: 1rem 1.25rem;
                  background: color-mix(in srgb, var(--accent) 5%, transparent);
                  border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
                  border-radius: 10px;
                  flex-wrap: wrap;
                ">
                  {[
                    { num: '93.5%', label: 'Accuracy' },
                    { num: '0.96', label: 'AUC-ROC' },
                    { num: '+3%', label: 'over static averaging' },
                  ].map((m) => (
                    <div>
                      <div style="
                        font-family: var(--font-serif);
                        font-size: 1.75rem;
                        font-style: italic;
                        color: var(--text-gradient, var(--accent));
                        line-height: 1;
                        background: linear-gradient(135deg, var(--grad-start), var(--grad-end));
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                      ">{m.num}</div>
                      <div style="
                        font-family: var(--font-mono);
                        font-size: 0.6875rem;
                        color: var(--text-tertiary);
                        margin-top: 0.1rem;
                      ">{m.label}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {pub.data.url && (
              <a
                href={pub.data.url}
                target="_blank"
                rel="noopener"
                aria-label={`Read ${pub.data.title} on IEEE Xplore`}
                style="
                  display: flex;
                  align-items: center;
                  gap: 0.3rem;
                  font-family: var(--font-mono);
                  font-size: 0.6875rem;
                  color: var(--accent);
                  white-space: nowrap;
                  flex-shrink: 0;
                  padding: 0.5rem 0.875rem;
                  border: 1px solid var(--accent);
                  border-radius: 6px;
                  transition: background 0.2s;
                "
                onmouseover="this.style.background='color-mix(in srgb, var(--accent) 10%, transparent)'"
                onmouseout="this.style.background='transparent'"
              >
                Read ↗
              </a>
            )}
          </article>
        ))}
      </div>
    </div>

    <!-- Patents -->
    <div class="reveal">
      <span class="eyebrow" style="display:block; margin-bottom: 2rem;">Patents — Indian Patent Applications</span>
      <div style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
      ">
        {patents.map((patent) => (
          <div style="
            padding: 1.75rem;
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: var(--shadow-sm);
          ">
            <div style="
              display: flex;
              align-items: center;
              justify-content: space-between;
              margin-bottom: 1rem;
            ">
              <span style="
                font-family: var(--font-mono);
                font-size: 0.625rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--accent-warm);
                padding: 0.2rem 0.5rem;
                border: 1px solid var(--accent-warm);
                border-radius: 3px;
              ">Filed & Published</span>
              <span style="
                font-family: var(--font-mono);
                font-size: 0.625rem;
                color: var(--text-tertiary);
              ">{patent.data.publishedDate}</span>
            </div>
            <h3 style="
              font-family: var(--font-serif);
              font-size: 1.1rem;
              line-height: 1.35;
              color: var(--text-primary);
              margin-bottom: 0.75rem;
            ">{patent.data.title}</h3>
            <p style="
              font-family: var(--font-mono);
              font-size: 0.6875rem;
              color: var(--text-tertiary);
              margin-bottom: 0.75rem;
            ">Application No. {patent.data.applicationNumber}</p>
            <p style="
              font-size: 0.875rem;
              color: var(--text-secondary);
              line-height: 1.6;
            ">{patent.data.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 640px) {
    .pub-card {
      grid-template-columns: 1fr !important;
      padding: 1.25rem !important;
      gap: 1.25rem !important;
    }
  }
</style>
