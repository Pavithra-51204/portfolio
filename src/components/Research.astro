---
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const patents = (await getCollection('patents')).sort((a, b) => a.data.order - b.data.order);
---

<section id="research" class="site-section">
  <div class="section-container">
    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 3.5rem;">
      <span class="eyebrow">05 — Academic Output</span>
      <h2 class="section-heading">Research & Publications</h2>
      <p style="font-size: 1rem; color: var(--text-secondary); max-width: 58ch;">
        Peer-reviewed IEEE publications and published patent applications in agentic AI and intelligent cloud systems.
      </p>
    </div>

    <!-- Publications Section -->
    <div style="margin-bottom: 4rem;">
      <h3
        style="
          font-family: var(--font-mono);
          font-size: 0.75rem;
          font-weight: 600;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: var(--accent);
          margin-bottom: 1.5rem;
          display: flex;
          align-items: center;
          gap: 0.5rem;
        "
      >
        <span>IEEE Publications</span>
        <span style="height: 1px; flex: 1; background: var(--border-subtle);"></span>
      </h3>

      <div style="display: flex; flex-direction: column; gap: 2rem;">
        {publications.map((pub) => (
          <article class="app-card" style="padding: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.85rem;">
              <span class="ieee-badge">IEEE Xplore</span>
              {pub.data.url && (
                <a
                  href={pub.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="
                    display: inline-flex;
                    align-items: center;
                    gap: 0.35rem;
                    font-family: var(--font-mono);
                    font-size: 0.75rem;
                    font-weight: 600;
                    color: var(--accent);
                  "
                >
                  <span>Read Paper</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              )}
            </div>

            <h4 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--text-primary); line-height: 1.35; margin-bottom: 0.75rem;">
              {pub.data.title}
            </h4>

            <p style="font-size: 0.9375rem; line-height: 1.7; color: var(--text-secondary); margin-bottom: 0;">
              {pub.data.summary}
            </p>
          </article>
        ))}
      </div>
    </div>

    <!-- Patents Section -->
    <div>
      <h3
        style="
          font-family: var(--font-mono);
          font-size: 0.75rem;
          font-weight: 600;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: var(--accent);
          margin-bottom: 1.5rem;
          display: flex;
          align-items: center;
          gap: 0.5rem;
        "
      >
        <span>Patents — Indian Patent Applications</span>
        <span style="height: 1px; flex: 1; background: var(--border-subtle);"></span>
      </h3>

      <div
        style="
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
          gap: 1.5rem;
        "
      >
        {patents.map((patent) => (
          <div class="app-card" style="padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600; text-transform: uppercase; color: #10B981; border: 1px solid #10B981; padding: 0.2rem 0.5rem; border-radius: 4px; background: color-mix(in srgb, #10B981 10%, transparent);">
                  Published
                </span>
                <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-tertiary);">
                  {patent.data.publishedDate}
                </span>
              </div>

              <h4 style="font-family: var(--font-heading); font-size: 1.125rem; font-weight: 700; color: var(--text-primary); line-height: 1.4; margin-bottom: 0.75rem;">
                {patent.data.title}
              </h4>

              <p style="font-size: 0.875rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 1rem;">
                {patent.data.summary}
              </p>
            </div>

            <div style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-tertiary); border-top: 1px solid var(--border-subtle); padding-top: 0.75rem;">
              Application No. <strong style="color: var(--text-primary);">{patent.data.applicationNumber}</strong>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
