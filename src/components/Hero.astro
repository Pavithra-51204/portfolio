---
import { site } from '../data/site';
---

<section
  id="hero"
  class="relative overflow-hidden"
  style="
    padding-top: 110px;
    padding-bottom: 64px;
    background: radial-gradient(circle at 75% 25%, color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 60%);
  "
>
  <div class="section-container">
    <!-- Two Column Hero Layout matching the Reference -->
    <div
      style="
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem;
        align-items: center;
      "
      class="hero-grid"
    >
      <!-- Left Column: Bio & Action -->
      <div>
        <!-- Eyebrow row with Availability Pill -->
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
          <span class="eyebrow">{site.role} · {site.location}</span>
          <span
            style="
              display: inline-flex;
              align-items: center;
              gap: 0.5rem;
              padding: 0.35rem 0.85rem;
              border: 1px solid color-mix(in srgb, #10B981 40%, transparent);
              border-radius: 100px;
              font-family: var(--font-mono);
              font-size: 0.6875rem;
              font-weight: 500;
              color: #10B981;
              background: color-mix(in srgb, #10B981 10%, transparent);
              max-width: 100%;
              line-height: 1.35;
            "
          >
            <span class="pulse-dot"></span>
            <span>Applying for MS in AI / ML / Data Science, Fall 2027</span>
          </span>
        </div>

        <!-- Heading: "Hi, I am {Pavithra Manogaran}" with curly braces matching reference -->
        <h1
          style="
            font-family: var(--font-heading);
            font-size: clamp(2.5rem, 5.5vw, 4.25rem);
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.03em;
            color: var(--text-primary);
            margin-bottom: 1.25rem;
          "
        >
          Hi, I am<br />
          <span class="text-gradient">&#123;Pavithra Manogaran&#125;</span>
        </h1>

        <!-- Tagline -->
        <p
          style="
            font-family: var(--font-heading);
            font-size: clamp(1.125rem, 2vw, 1.375rem);
            font-weight: 500;
            color: var(--accent);
            line-height: 1.4;
            margin-bottom: 1.25rem;
          "
        >
          I build agentic AI systems that run in production.
        </p>

        <!-- 2-sentence summary paragraph -->
        <p
          style="
            font-size: 1rem;
            line-height: 1.7;
            color: var(--text-secondary);
            max-width: 54ch;
            margin-bottom: 2rem;
          "
        >
          From multi-agent orchestration and RAG pipelines to SAP enterprise platforms and cloud/DevOps infrastructure — I build systems where the architecture matters. Pursuing a Master's focused on agentic AI, model evaluation, and scalable ML systems.
        </p>

        <!-- Action CTAs -->
        <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
          <a
            href={site.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Download Resume
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
          <a href="#projects" class="btn-secondary">
            View Projects
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Portrait on Brush/Blob with Floating Circuit Nodes (matches reference) -->
      <div style="display: flex; justify-content: center; position: relative;">
        <div
          class="portrait-stage"
          style="
            position: relative;
            width: min(100%, 360px);
            aspect-ratio: 1 / 1.15;
            display: flex;
            align-items: center;
            justify-content: center;
          "
        >
          <!-- SVG Blob / Brush stroke background -->
          <svg
            viewBox="0 0 200 220"
            aria-hidden="true"
            style="
              position: absolute;
              inset: 0;
              width: 100%;
              height: 100%;
              z-index: 0;
              filter: drop-shadow(0 15px 30px color-mix(in srgb, var(--accent) 30%, transparent));
            "
          >
            <path
              d="M38.5,-54.6C49.9,-48.5,59,-37.8,64.8,-25.2C70.6,-12.6,73.1,1.9,70.5,15.6C67.8,29.3,60,42.2,49,51.8C38,61.4,23.8,67.7,8.7,70.1C-6.4,72.5,-22.4,71,-35.7,63.4C-49.1,55.8,-59.8,42.1,-66.2,26.9C-72.5,11.7,-74.5,-5,-69.7,-19.6C-64.8,-34.2,-53,-46.7,-39.7,-52.3C-26.4,-57.9,-11.7,-56.6,1.4,-58.8C14.6,-61,27.1,-60.7,38.5,-54.6Z"
              transform="translate(100 110)"
              fill="var(--accent)"
              opacity="0.85"
            />
          </svg>

          <!-- Floating decorative circuit nodes -->
          <div
            aria-hidden="true"
            style="
              position: absolute;
              top: -10px;
              right: 15px;
              width: 50px;
              height: 50px;
              border-radius: 50%;
              border: 1px dashed var(--accent);
              opacity: 0.6;
              animation: float-slow 4s ease-in-out infinite;
            "
          ></div>
          <div
            aria-hidden="true"
            style="
              position: absolute;
              bottom: 20px;
              left: -15px;
              width: 38px;
              height: 38px;
              border-radius: 50%;
              background: color-mix(in srgb, var(--accent-aqua) 20%, transparent);
              border: 1px solid var(--accent-aqua);
              animation: float-slow 3.2s ease-in-out infinite reverse;
            "
          ></div>

          <!-- Crisp portrait image with rounded clip -->
          <img
            src="/images/pavithra-profile.png"
            alt="Portrait of Pavithra Manogaran"
            width="320"
            height="370"
            loading="eager"
            decoding="async"
            style="
              position: relative;
              z-index: 1;
              width: 86%;
              height: 92%;
              object-fit: cover;
              object-position: center top;
              border-radius: 28px;
              border: 2px solid rgba(255, 255, 255, 0.25);
              box-shadow: var(--shadow-lg);
              display: block;
            "
          />
        </div>
      </div>
    </div>

    <!-- Stat Strip below the Hero (full-width, 5 balanced cells) -->
    <div
      id="stat-strip"
      class="app-card stat-strip-container"
      style="
        margin-top: 4rem;
        display: grid;
        overflow: hidden;
      "
    >
      {[
        { number: '2',     suffix: '', label: 'IEEE publications' },
        { number: '2',     suffix: '', label: 'Patents filed' },
        { number: '93.5',  suffix: '%', label: 'Flood-forecast accuracy' },
        { number: '503 → 94', suffix: ' ms', label: 'p99 latency (VelocityLB)' },
        { number: '6',     suffix: '', label: 'Flagship projects' },
      ].map((stat) => (
        <div
          class="stat-cell"
          data-target={stat.number}
          data-suffix={stat.suffix}
          style="
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
          "
        >
          <div
            style="
              font-family: var(--font-heading);
              font-size: clamp(1.75rem, 3vw, 2.5rem);
              font-weight: 700;
              color: var(--text-primary);
              line-height: 1.1;
              letter-spacing: -0.02em;
            "
          >
            <span class="stat-num">{stat.number}</span>
            <span style="font-size: 0.7em; color: var(--accent);">{stat.suffix}</span>
          </div>
          <div
            style="
              font-family: var(--font-mono);
              font-size: 0.6875rem;
              color: var(--text-tertiary);
              margin-top: 0.35rem;
              text-transform: uppercase;
              letter-spacing: 0.05em;
            "
          >
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr !important;
    }
  }

  .stat-strip-container {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .stat-cell:not(:last-child) {
    border-right: 1px solid var(--border-subtle);
  }

  @media (max-width: 1024px) {
    .stat-strip-container {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .stat-cell:nth-child(3) {
      border-right: none;
    }
    .stat-cell:nth-child(1),
    .stat-cell:nth-child(2),
    .stat-cell:nth-child(3) {
      border-bottom: 1px solid var(--border-subtle);
    }
  }

  @media (max-width: 640px) {
    .stat-strip-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat-cell {
      border-right: none !important;
      border-bottom: 1px solid var(--border-subtle);
    }
    .stat-cell:nth-child(odd) {
      border-right: 1px solid var(--border-subtle) !important;
    }
    .stat-cell:last-child {
      grid-column: span 2;
      border-bottom: none;
    }
  }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
</style>
