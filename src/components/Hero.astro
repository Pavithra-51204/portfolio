---
import { site } from '../data/site';
---

<section class="bg-panel-dark text-paper">
  <div class="mx-auto flex max-w-5xl flex-col gap-10 px-6 py-16 md:py-24 lg:flex-row lg:items-center lg:gap-16">
    <div class="flex flex-col gap-6 lg:w-[45%]">
      <div class="flex items-center gap-2 font-mono text-xs text-paper/60">
        <span class="inline-block h-2 w-2 rounded-full bg-ok"></span>
        <span>final-year cse &middot; graduating 2026</span>
      </div>
      <div>
        <h1 class="text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
          {site.name}
        </h1>
        <p class="mt-2 font-mono text-lg text-paper/70">{site.role}</p>
      </div>
      <p class="max-w-md text-base leading-relaxed text-paper/80">
        {site.description}
      </p>
      <div class="flex flex-wrap gap-3 font-mono text-sm">
        <a
          href="#work"
          class="border border-paper/30 px-4 py-2 text-paper transition-colors hover:border-signal hover:text-signal"
        >
          see the work
        </a>
        <a
          href={site.resumeUrl}
          class="border border-paper/30 px-4 py-2 text-paper transition-colors hover:border-signal hover:text-signal"
        >
          resume.pdf
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-4 lg:w-[55%]">
      <svg
        viewBox="0 0 640 280"
        role="img"
        aria-labelledby="routing-diagram-title routing-diagram-desc"
        class="w-full"
      >
        <title id="routing-diagram-title">Adaptive request routing, from VelocityLB</title>
        <desc id="routing-diagram-desc">
          A client sends requests to three backend nodes. Node A and Node C are healthy with p99
          latency of 41ms and 38ms. Node B is degraded at 503ms latency and is routed around.
        </desc>

        <!-- client -->
        <g>
          <circle cx="60" cy="140" r="26" fill="none" stroke="#F4F5F1" stroke-opacity="0.5" stroke-width="1.5" />
          <text x="60" y="145" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#F4F5F1">client</text>
        </g>

        <!-- paths -->
        <path d="M 86 140 C 150 80, 220 60, 300 55" fill="none" stroke="#4C9A6A" stroke-width="1.5" />
        <path d="M 86 140 L 300 140" fill="none" stroke="#C97A3D" stroke-width="1.5" stroke-dasharray="4 5" />
        <path d="M 86 140 C 150 200, 220 220, 300 225" fill="none" stroke="#4C9A6A" stroke-width="1.5" />

        <!-- node A: healthy -->
        <g>
          <rect x="300" y="30" width="180" height="50" rx="2" fill="none" stroke="#F4F5F1" stroke-opacity="0.3" stroke-width="1.5" />
          <circle cx="316" cy="55" r="4" fill="#4C9A6A" />
          <text x="330" y="50" font-family="IBM Plex Mono, monospace" font-size="12" fill="#F4F5F1">node A &middot; healthy</text>
          <text x="330" y="67" font-family="IBM Plex Mono, monospace" font-size="12" fill="#4C9A6A">p99 41ms</text>
        </g>

        <!-- node B: degraded -->
        <g>
          <rect x="300" y="115" width="180" height="50" rx="2" fill="none" stroke="#F4F5F1" stroke-opacity="0.3" stroke-width="1.5" />
          <circle cx="316" cy="140" r="4" fill="#C97A3D" />
          <text x="330" y="135" font-family="IBM Plex Mono, monospace" font-size="12" fill="#F4F5F1">node B &middot; degraded</text>
          <text x="330" y="152" font-family="IBM Plex Mono, monospace" font-size="12" fill="#C97A3D">p99 503ms &mdash; avoided</text>
        </g>

        <!-- node C: healthy -->
        <g>
          <rect x="300" y="200" width="180" height="50" rx="2" fill="none" stroke="#F4F5F1" stroke-opacity="0.3" stroke-width="1.5" />
          <circle cx="316" cy="225" r="4" fill="#4C9A6A" />
          <text x="330" y="220" font-family="IBM Plex Mono, monospace" font-size="12" fill="#F4F5F1">node C &middot; healthy</text>
          <text x="330" y="237" font-family="IBM Plex Mono, monospace" font-size="12" fill="#4C9A6A">p99 38ms</text>
        </g>
      </svg>

      <blockquote class="border-l-2 border-signal/60 pl-4 font-mono text-xs leading-relaxed text-paper/70">
        &ldquo;Adaptive routing held p99 under 100ms while round-robin hit 503ms &mdash; a 5&ndash;7x
        difference.&rdquo;
        <footer class="mt-1 text-paper/50">&mdash; VelocityLB, live benchmark</footer>
      </blockquote>
    </div>
  </div>
</section>
