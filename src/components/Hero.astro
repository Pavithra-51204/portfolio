---
import { site } from '../data/site';
---

<section class="bg-panel-dark text-paper">
  <div class="mx-auto flex max-w-2xl flex-col gap-8 px-6 py-24 md:py-32">
    <h1 class="text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
      {site.name}
    </h1>
    <p class="max-w-prose text-base leading-relaxed text-paper/80">
      {site.description}
    </p>
    <div class="flex flex-wrap gap-3 font-mono text-sm">
      <a
        href="#projects"
        class="border border-paper/30 px-4 py-2 text-paper transition-colors hover:border-signal hover:text-signal"
      >
        see the projects
      </a>
      <a
        href={site.resumeUrl}
        class="border border-paper/30 px-4 py-2 text-paper transition-colors hover:border-signal hover:text-signal"
      >
        resume.pdf
      </a>
    </div>
  </div>
</section>
