---
import { getCollection } from 'astro:content';

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" style="
  padding: 7rem 0;
  border-top: 1px solid var(--border);
">
  <div class="section-container">
    <div class="reveal" style="margin-bottom: 4rem;">
      <span class="eyebrow">03 — Experience</span>
      <h2 style="
        font-family: var(--font-serif);
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-top: 0.75rem;
      ">
        Where I've worked.
      </h2>
    </div>

    <!-- Timeline -->
    <div style="
      position: relative;
      max-width: 800px;
    ">
      <!-- Vertical line -->
      <div
        id="timeline-line"
        aria-hidden="true"
        style="
          position: absolute;
          left: 0;
          top: 0;
          bottom: 0;
          width: 1px;
          background: var(--border);
          transform-origin: top;
        "
      ></div>

      <div style="display: flex; flex-direction: column; gap: 0;">
        {entries.map((entry, index) => (
          <div
            class={`timeline-entry reveal`}
            style="
              position: relative;
              padding-left: 2.5rem;
              padding-bottom: 3.5rem;
            "
          >
            <!-- Node dot -->
            <div
              class="timeline-node"
              aria-hidden="true"
              style="
                position: absolute;
                left: -6px;
                top: 4px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: var(--bg-surface);
                border: 2px solid var(--border);
                transition: border-color 0.3s, background 0.3s;
                z-index: 1;
              "
            ></div>

            <!-- Date + location pill -->
            <div style="
              font-family: var(--font-mono);
              font-size: 0.6875rem;
              color: var(--text-tertiary);
              margin-bottom: 0.75rem;
              display: flex;
              gap: 0.5rem;
              align-items: center;
              flex-wrap: wrap;
            ">
              <span>{entry.data.start} – {entry.data.end}</span>
              <span style="color: var(--border-subtle); user-select:none;">·</span>
              <span style="
                padding: 0.15rem 0.5rem;
                border: 1px solid var(--border);
                border-radius: 100px;
                font-size: 0.625rem;
              ">{entry.data.location}</span>
            </div>

            <!-- Role + company -->
            <h3 style="
              font-family: var(--font-serif);
              font-size: 1.375rem;
              line-height: 1.2;
              color: var(--text-primary);
              margin-bottom: 0.25rem;
            ">{entry.data.role}</h3>
            <p style="
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--accent);
              margin-bottom: 1rem;
            ">{entry.data.org}</p>

            <!-- Impact statement -->
            <p style="
              font-style: italic;
              font-size: 0.9375rem;
              color: var(--text-secondary);
              line-height: 1.6;
              border-left: 2px solid var(--accent);
              padding-left: 1rem;
              margin-bottom: 1.25rem;
            ">"{entry.data.outcome}"</p>

            <!-- Bullets -->
            <ul style="display: flex; flex-direction: column; gap: 0.5rem;">
              {entry.data.bullets.map((bullet) => (
                <li style="
                  display: flex;
                  gap: 0.75rem;
                  font-size: 0.9rem;
                  color: var(--text-secondary);
                  line-height: 1.6;
                ">
                  <span style="
                    color: var(--text-tertiary);
                    flex-shrink: 0;
                    margin-top: 0.4em;
                    font-size: 0.5rem;
                  ">●</span>
                  {bullet}
                </li>
              ))}
            </ul>

            <!-- Optional evidence link -->
            {entry.data.evidence && (
              <a
                href={entry.data.evidence.url}
                target="_blank"
                rel="noopener"
                style="
                  display: inline-flex;
                  align-items: center;
                  gap: 0.3rem;
                  margin-top: 1rem;
                  font-family: var(--font-mono);
                  font-size: 0.6875rem;
                  color: var(--accent);
                  text-decoration: underline;
                  text-underline-offset: 3px;
                "
              >
                {entry.data.evidence.label}
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 640px) {
    .timeline-entry {
      padding-left: 1.5rem !important;
      padding-bottom: 2.5rem !important;
    }
  }
</style>

<script is:inline>
  // ── Timeline line draw on scroll ─────────────────────────────────────────────
  (function () {
    var line = document.getElementById('timeline-line');
    var nodes = document.querySelectorAll('.timeline-node');
    if (!line) return;

    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      line.style.background = 'linear-gradient(to bottom, var(--accent), color-mix(in srgb, var(--accent) 20%, transparent))';
      nodes.forEach(function(n) {
        n.style.borderColor = 'var(--accent)';
        n.style.background = 'color-mix(in srgb, var(--accent) 15%, var(--bg-surface))';
      });
      return;
    }

    function update() {
      var rect = line.parentElement.getBoundingClientRect();
      var windowH = window.innerHeight;
      var progress = Math.min(Math.max((windowH - rect.top) / (rect.height + windowH * 0.3), 0), 1);

      // Draw gradient along the line proportional to scroll
      var pct = Math.round(progress * 100);
      line.style.background = `linear-gradient(to bottom, var(--accent) 0%, var(--accent) ${pct}%, var(--border) ${pct}%, var(--border) 100%)`;

      // Activate nodes
      nodes.forEach(function (node, i) {
        var nodePct = (i + 0.5) / nodes.length;
        if (progress >= nodePct) {
          node.style.borderColor = 'var(--accent)';
          node.style.background = 'color-mix(in srgb, var(--accent) 15%, var(--bg-surface))';
        } else {
          node.style.borderColor = 'var(--border)';
          node.style.background = 'var(--bg-surface)';
        }
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
