---
import { getCollection } from 'astro:content';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="border-t border-ink/10">
  <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
    <h2 class="mb-8 text-2xl font-semibold tracking-tight md:text-3xl">Experience</h2>

    <ol class="relative border-l border-ink/15 pl-8">
      {experience.map((job) => (
        <li class="mb-12 last:mb-0">
          <span class="absolute -left-[5px] mt-1.5 h-2.5 w-2.5 rounded-full border-2 border-paper bg-signal"></span>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h3 class="text-lg font-medium text-ink">
              {job.data.role} <span class="font-normal text-ink/65">&middot; {job.data.org}</span>
            </h3>
            <span class="shrink-0 font-mono text-xs text-ink/65">
              {job.data.start} &ndash; {job.data.end} &middot; {job.data.location}
            </span>
          </div>
          <p class="mt-2 font-mono text-sm text-signal">{job.data.outcome}</p>
          <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-ink/75">
            {job.data.bullets.map((bullet) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink/30"></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
          {job.data.evidence && (
            <a
              href={job.data.evidence.url}
              class="mt-3 inline-block font-mono text-xs text-ink/65 underline decoration-ink/30 underline-offset-4 hover:text-signal hover:decoration-signal"
            >
              {job.data.evidence.label}
            </a>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
