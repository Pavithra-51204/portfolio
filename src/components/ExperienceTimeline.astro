---
import { getCollection } from 'astro:content';

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="site-section">
  <div class="section-container">
    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 3.5rem;">
      <span class="eyebrow">04 — Journey</span>
      <h2 class="section-heading">Work Experience</h2>
      <p style="font-size: 1rem; color: var(--text-secondary); max-width: 54ch;">
        Hands-on systems engineering, enterprise AI deployment, and cloud infrastructure automation.
      </p>
    </div>

    <!-- Vertical Timeline matching reference structure -->
    <div
      style="
        position: relative;
        max-width: 860px;
        margin-left: 0.5rem;
      "
    >
      <!-- Timeline Central Line -->
      <div
        aria-hidden="true"
        style="
          position: absolute;
          left: 11px;
          top: 8px;
          bottom: 24px;
          width: 2px;
          background: linear-gradient(180deg, var(--accent) 0%, var(--border) 100%);
        "
      ></div>

      <div style="display: flex; flex-direction: column; gap: 2.75rem;">
        {entries.map((entry) => (
          <div
            style="
              position: relative;
              padding-left: 3rem;
            "
          >
            <!-- Timeline Node Dot -->
            <div
              aria-hidden="true"
              style="
                position: absolute;
                left: 3px;
                top: 4px;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--bg-surface);
                border: 3px solid var(--accent);
                box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 40%, transparent);
                z-index: 2;
              "
            ></div>

            <!-- Experience Card -->
            <div class="app-card" style="padding: 1.75rem;">
              <!-- Role, Org, Date & Location -->
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.75rem;">
                <div>
                  <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin: 0;">
                    {entry.data.role}
                  </h3>
                  <span style="font-family: var(--font-heading); font-size: 0.9375rem; font-weight: 600; color: var(--accent);">
                    {entry.data.org}
                  </span>
                </div>

                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                  <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-secondary); background: var(--border-subtle); padding: 0.2rem 0.6rem; border-radius: 4px;">
                    {entry.data.start} – {entry.data.end}
                  </span>
                  <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-tertiary); border: 1px solid var(--border); padding: 0.2rem 0.5rem; border-radius: 4px;">
                    {entry.data.location}
                  </span>
                </div>
              </div>

              <!-- Impact Statement Quote -->
              <div
                style="
                  margin-bottom: 1.25rem;
                  padding-left: 1rem;
                  border-left: 2px solid var(--accent);
                  font-size: 0.9375rem;
                  font-style: italic;
                  color: var(--text-primary);
                  font-weight: 500;
                  line-height: 1.5;
                "
              >
                &ldquo;{entry.data.outcome}&rdquo;
              </div>

              <!-- Bullets -->
              <ul style="display: flex; flex-direction: column; gap: 0.6rem; margin: 0; padding: 0; list-style: none;">
                {entry.data.bullets.map((bullet) => (
                  <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9375rem; line-height: 1.6; color: var(--text-secondary);">
                    <span style="color: var(--accent); font-size: 0.75rem; margin-top: 0.15rem; flex-shrink: 0;">▸</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Evidence Link -->
              {entry.data.evidence && (
                <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle);">
                  <a
                    href={entry.data.evidence.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="
                      display: inline-flex;
                      align-items: center;
                      gap: 0.4rem;
                      font-family: var(--font-mono);
                      font-size: 0.75rem;
                      font-weight: 600;
                      color: var(--accent);
                    "
                  >
                    <span>{entry.data.evidence.label}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
