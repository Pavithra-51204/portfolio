---
import { site } from '../data/site';
---

<section id="contact" class="border-t border-ink/10 bg-panel-dark text-paper">
  <div class="mx-auto flex max-w-xl flex-col items-center gap-6 px-6 py-24 text-center md:py-32">
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Contact</h2>
    <p class="max-w-prose text-sm leading-relaxed text-paper/75">
      The fastest way to reach me is email &mdash; I read every message.
    </p>
    <a href={`mailto:${site.email}`} class="font-mono text-lg text-paper hover:text-signal md:text-xl">
      {site.email}
    </a>
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-sm">
      <a href={site.links.linkedin} class="text-paper/70 hover:text-signal">LinkedIn</a>
      <a href={site.links.github} class="text-paper/70 hover:text-signal">GitHub</a>
      <a href={site.links.medium} class="text-paper/70 hover:text-signal">Medium</a>
      <a href={site.resumeUrl} class="text-paper/70 hover:text-signal">resume.pdf</a>
    </div>
  </div>
</section>
