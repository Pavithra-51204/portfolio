---
import { education, certifications, extracurricular } from '../data/site';
import { site } from '../data/site';
---

<section id="about" style="
  padding: 7rem 0;
  border-top: 1px solid var(--border);
">
  <div class="section-container">
    <!-- Section header -->
    <div class="reveal" style="margin-bottom: 4rem;">
      <span class="eyebrow">01 — About</span>
      <h2 style="
        font-family: var(--font-serif);
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-top: 0.75rem;
        color: var(--text-primary);
      ">
        Systems thinker.<br/>
        <span class="text-gradient" style="font-style:italic;">Research-driven builder.</span>
      </h2>
    </div>

    <!-- Two-column layout -->
    <div style="
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 5rem;
      align-items: start;
    " class="about-grid">
      <!-- Left: portrait -->
      <div class="reveal" style="position: relative; max-width: 280px; width: 100%; flex-shrink: 0; margin-inline: auto;">
        <!-- Accent offset border -->
        <div aria-hidden="true" style="
          position: absolute;
          top: 10px;
          left: 10px;
          right: -10px;
          bottom: -10px;
          border: 2px solid var(--accent);
          border-radius: 16px;
          opacity: 0.35;
          pointer-events: none;
        "></div>
        <picture>
          <source srcset="/images/pavithra-profile.webp" type="image/webp" width="280" height="320" />
          <img
            src="/images/pavithra-profile.png"
            alt="Portrait of Pavithra Manogaran"
            width="280"
            height="320"
            loading="lazy"
            decoding="async"
          style="
            width: 100%;
            height: 320px;
            object-fit: cover;
            object-position: center top;
            border-radius: 14px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
            position: relative;
            z-index: 1;
            display: block;
          "
        />
        </picture>
      </div>

      <!-- Right: content -->
      <div class="reveal stagger-children" style="display: flex; flex-direction: column; gap: 3rem;">
        <!-- Full bio -->
        <div>
          <p style="
            font-size: 1.0625rem;
            line-height: 1.75;
            color: var(--text-secondary);
            max-width: 60ch;
          ">
            {site.description}
          </p>
        </div>

        <!-- Education -->
        <div>
          <span class="eyebrow" style="display:block; margin-bottom: 1.25rem;">Education</span>
          <div style="display: flex; flex-direction: column; gap: 1.5rem; position: relative;">
            <!-- Timeline line -->
            <div aria-hidden="true" style="
              position: absolute;
              left: 5px;
              top: 8px;
              bottom: 8px;
              width: 1px;
              background: linear-gradient(to bottom, var(--accent), color-mix(in srgb, var(--accent) 20%, transparent));
            "></div>
            {education.map((item) => (
              <div style="display: flex; gap: 1.5rem; padding-left: 1.5rem; position: relative;">
                <div aria-hidden="true" style="
                  position: absolute;
                  left: 1px;
                  top: 6px;
                  width: 9px;
                  height: 9px;
                  border-radius: 50%;
                  background: var(--accent);
                  flex-shrink: 0;
                "></div>
                <div>
                  <p style="
                    font-size: 0.9375rem;
                    font-weight: 500;
                    color: var(--text-primary);
                    line-height: 1.3;
                  ">{item.school}</p>
                  <p style="
                    font-size: 0.875rem;
                    color: var(--text-secondary);
                    margin-top: 0.1rem;
                  ">{item.program}</p>
                  <p style="
                    font-family: var(--font-mono);
                    font-size: 0.6875rem;
                    color: var(--text-tertiary);
                    margin-top: 0.25rem;
                  ">
                    {item.start ? `${item.start} – ${item.end}` : item.end} · {item.detail}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div>
          <span class="eyebrow" style="display:block; margin-bottom: 1rem;">Certifications</span>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {certifications.map((cert) => (
              <span class="chip">{cert}</span>
            ))}
          </div>
        </div>

        <!-- Extracurricular -->
        <div>
          <span class="eyebrow" style="display:block; margin-bottom: 1rem;">Highlights</span>
          <ul style="display: flex; flex-direction: column; gap: 0.625rem;">
            {extracurricular.map((item) => (
              <li style="
                display: flex;
                gap: 0.75rem;
                align-items: flex-start;
                font-size: 0.9375rem;
                color: var(--text-secondary);
                line-height: 1.5;
              ">
                <span style="
                  color: var(--accent);
                  flex-shrink: 0;
                  margin-top: 0.1em;
                  font-size: 0.75rem;
                ">▸</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
  }
</style>
