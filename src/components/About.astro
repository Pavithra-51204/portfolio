---
import { education } from '../data/site';
---

<section id="about" class="site-section">
  <div class="section-container">
    <div
      style="
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem;
        align-items: start;
      "
      class="about-layout"
    >
      <!-- Left Column: Title -->
      <div>
        <span class="eyebrow">01 — Background</span>
        <h2 class="section-heading">About me</h2>
      </div>

      <!-- Right Column: Terminal Window Card + Education Block -->
      <div style="display: flex; flex-direction: column; gap: 2.5rem;">
        <!-- Terminal-Style Window Card matching reference -->
        <div
          class="app-card"
          style="
            overflow: hidden;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
          "
        >
          <!-- Window Titlebar with 3 dots & Sparkle -->
          <div
            style="
              display: flex;
              align-items: center;
              justify-content: space-between;
              padding: 0.75rem 1.25rem;
              background: color-mix(in srgb, var(--accent) 5%, var(--bg-surface));
              border-bottom: 1px solid var(--border-subtle);
            "
          >
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span style="width: 11px; height: 11px; border-radius: 50%; background: #EF4444; display: inline-block;"></span>
              <span style="width: 11px; height: 11px; border-radius: 50%; background: #F59E0B; display: inline-block;"></span>
              <span style="width: 11px; height: 11px; border-radius: 50%; background: #10B981; display: inline-block;"></span>
              <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-tertiary); margin-left: 0.5rem;">bio.sh</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--accent);">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.8-6.4 4.8 2.4-7.2-6-4.8h7.6z"/>
              </svg>
              <span>profile</span>
            </div>
          </div>

          <!-- Bio text inside window -->
          <div style="padding: 1.75rem; font-size: 1.0625rem; line-height: 1.75; color: var(--text-secondary);">
            <p style="margin: 0;">
              Experienced in AI/ML systems design and development, with a strong foundation in SAP enterprise platforms, cloud infrastructure, DevOps, and full-stack development. Skilled in agentic AI, retrieval-augmented generation, multi-agent orchestration, and model evaluation, with hands-on experience in SAP ABAP/OData development, AWS and Azure deployments, and CI/CD automation. Seeking to pursue a Master's to deepen my skills in artificial intelligence, machine learning, and data science, with a focus on building practical and scalable AI systems.
            </p>
          </div>
        </div>

        <!-- Education block below terminal card -->
        <div class="app-card" style="padding: 1.75rem;">
          <h3
            style="
              font-family: var(--font-mono);
              font-size: 0.75rem;
              font-weight: 600;
              letter-spacing: 0.1em;
              text-transform: uppercase;
              color: var(--accent);
              margin-bottom: 1.5rem;
              display: flex;
              align-items: center;
              gap: 0.5rem;
            "
          >
            <span>Education</span>
            <span style="height: 1px; flex: 1; background: var(--border-subtle);"></span>
          </h3>

          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            {education.map((item) => (
              <div
                style="
                  display: flex;
                  flex-direction: column;
                  gap: 0.25rem;
                  padding-bottom: 1rem;
                  border-bottom: 1px dashed var(--border-subtle);
                "
              >
                <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;">
                  <h4 style="font-family: var(--font-heading); font-size: 1.0625rem; font-weight: 600; color: var(--text-primary); margin: 0;">
                    {item.school}
                  </h4>
                  <span style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--accent);">
                    {item.detail}
                  </span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;">
                  <span style="font-size: 0.875rem; color: var(--text-secondary);">
                    {item.program}
                  </span>
                  <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-tertiary);">
                    {item.start ? `${item.start}–${item.end}` : item.end}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 900px) {
    .about-layout {
      grid-template-columns: 280px 1fr !important;
    }
  }
</style>
